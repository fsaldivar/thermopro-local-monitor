# Registro local: BLE -> SQLite. Nada sale de la Raspberry.
# Instalar en /etc/systemd/system/thermopro-recorder.service
[Unit]
# Sin limite de reintentos: que insista indefinidamente.
StartLimitIntervalSec=0
Description=ThermoPro BLE recorder (SQLite local)
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=fermax
WorkingDirectory=/home/fermax/thermopro-local-monitor
ExecStart=/home/fermax/thermopro-local-monitor/.venv/bin/python thermopro_monitor.py record --db /var/lib/thermopro/thermopro.db --interval 60
Restart=always
RestartSec=10
# Es el que recoge los datos: que sea de los ultimos en caer.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
