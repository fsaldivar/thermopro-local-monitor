# Copia a .env y ajusta. Los servicios systemd pasan estas opciones en la
# linea de comandos, pero sirven para ejecutarlo a mano.

# --- BLE ---
# MAC del sensor. Si se omite, se autodetecta por prefijo de nombre (TP...).
THERMOPRO_ADDRESS=FB:E7:C4:CF:3A:F6
THERMOPRO_ADAPTER=hci0
THERMOPRO_LOG_LEVEL=INFO
# Escaneo pasivo: menos trafico de radio, requiere bluetoothd --experimental.
#THERMOPRO_PASSIVE=1

# --- Registro local ---
THERMOPRO_DB=/var/lib/thermopro/thermopro.db
# Segundos minimos entre filas de un mismo sensor.
THERMOPRO_INTERVAL=60
# Segundos sin datos tras los que se deja de escribir.
THERMOPRO_STALE_AFTER=300
# Borrar al arrancar lo anterior a N dias (0 = guardar todo).
THERMOPRO_RETENTION_DAYS=0

# --- Pantalla ---
# 270 deja la imagen derecha con los botones a la izquierda.
THERMOPRO_ROTATION=270

# --- MQTT (opcional, no hace falta para el uso local) ---
#MQTT_HOST=192.168.1.121
#MQTT_PORT=1883
#MQTT_TOPIC_PREFIX=thermopro
#MQTT_HA_DISCOVERY=1
