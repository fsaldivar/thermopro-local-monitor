# Panel en la LCD 1.3" del HAT. Lee la base en solo lectura: si se cae,
# el registro sigue intacto.
# Instalar en /etc/systemd/system/thermopro-display.service
[Unit]
# Sin limite de reintentos: que insista indefinidamente.
StartLimitIntervalSec=0
Description=ThermoPro LCD display
After=thermopro-recorder.service

[Service]
Type=simple
User=fermax
WorkingDirectory=/home/fermax/thermopro-ble-monitor
# python3 del sistema: trae PIL, numpy, spidev y gpiozero ya empaquetados.
ExecStart=/usr/bin/python3 display_app.py --db /var/lib/thermopro/thermopro.db --rotation 270
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
